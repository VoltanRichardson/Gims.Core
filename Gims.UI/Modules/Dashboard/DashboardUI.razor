@page "/dashboard"

@using Gims.UI.ShellUI.Workspace

@using Microsoft.AspNetCore.Components.Web

<h3>Dashboard UI Home page</h3>

<button @onclick='() => Console.WriteLine(" Dashboard button clicked")'>
    Test Button
</button>

<div style="position:fixed; bottom:0; left:0; background:#000; color:#0f0; padding:6px; z-index:999999;">
    Renderer: @RendererInfo.Name | Interactive: @RendererInfo.IsInteractive | Assigned: @AssignedRenderMode
</div>

@code {
    [CascadingParameter]
    public WorkspaceController Workspace { get; set; }
}
