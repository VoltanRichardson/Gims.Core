@page "/sysman/roles/add"
@page "/sysman/roles/edit/{Id:guid}"

@using Gims.App.Modules.SysMan.Dto
@using Gims.Contracts.Dto
@using Gims.UI.Services
@using Microsoft.AspNetCore.Components.Forms

@inject RolesApiClient RolesApi
@inject NavigationManager Navigation

<h3 class="mb-3">Role</h3>

<EditForm Model="role" OnValidSubmit="SaveRole">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="card p-4">

        <div class="mb-3">
            <label class="form-label">Code</label>
            <InputText class="form-control" @bind-Value="role.Code" />
        </div>

        <div class="mb-3">
            <label class="form-label">Name</label>
            <InputText class="form-control" @bind-Value="role.Name" />
        </div>

        <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea class="form-control" @bind="role.Description"></textarea>
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-primary" type="submit">Save</button>
            <button class="btn btn-secondary" type="button" @onclick="Cancel">Cancel</button>
        </div>

    </div>
</EditForm>

@code {
    [Parameter] public Guid? Id { get; set; }

    private RoleDto role = new RoleDto();
    private bool IsEdit => Id.HasValue;

    protected override async Task OnInitializedAsync()
    {
        if (IsEdit)
        {
            var existing = await RolesApi.GetRoleAsync(Id.Value);
            if (existing is not null)
                role = existing;
        }
    }

    private async Task SaveRole()
    {
        if (IsEdit)
        {
            var request = new UpdateRoleRequest(
                role.Id,
                role.Code,
                role.Name,
                role.Description
            );

            await RolesApi.UpdateRoleAsync(request);
        }
        else
        {
            var request = new CreateRoleRequest(
                role.Code,
                role.Name,
                role.Description
            );

            await RolesApi.CreateRoleAsync(request);
        }

        Navigation.NavigateTo("/sysman/roles");
    }

    private void Cancel() => Navigation.NavigateTo("/sysman/roles");
}